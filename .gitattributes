# Keep screenshots, docs and CI config in the repo; omit them from release archives.
screenshots/ export-ignore
screenshots/** export-ignore
docs/ export-ignore
docs/** export-ignore
.github/ export-ignore
.github/** export-ignore

# Local git metadata must never ship in the Moodle plugin zip.
.git/ export-ignore
.git/** export-ignore

# IDE stubs are not part of the shipped plugin.
tests/stubs/ export-ignore
tests/stubs/** export-ignore

# Packaging script stays in git, not in the Marketplace zip.
scripts/ export-ignore
scripts/** export-ignore

# Marketplace copy-paste notes stay in git, not in the plugin zip.
upgrade/release-note/ export-ignore
upgrade/release-note/** export-ignore
